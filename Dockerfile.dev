# Local Nuxt dev image for candor-core docker-compose `admin` service.
FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@11.24.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3001

# Bind-mount + named node_modules volume: re-install if volume is empty/out of date.
CMD ["sh", "-c", "pnpm install && exec pnpm dev --host 0.0.0.0 --port 3001"]
